{
  "manifest_version": 3,
  "name": "Better Deezer",
  "version": "0.0.0",
  "description": "Unofficial skin for the Deezer web player: themes, synced lyrics, floating player, volume wheel and more.",
  "homepage_url": "https://github.com/Gabizoc/Better-Deezer",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.deezer.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "exclude_matches": [
        "https://www.deezer.com/explore/*"
      ]
    },
    {
      "matches": [
        "https://www.deezer.com/*"
      ],
      "js": [
        "better-deezer.js"
      ],
      "css": [
        "better-deezer.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://www.deezer.com/explore/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.deezer.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}
